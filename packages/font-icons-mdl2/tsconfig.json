{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "es2015",
    "module": "commonjs",
    "lib": ["es5", "dom"],
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "strict": true,
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "preserveConstEnums": false,
    "types": []
  },
  "include": ["src"]
}
