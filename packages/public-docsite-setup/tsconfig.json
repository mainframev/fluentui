{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "lib",
    "target": "es2015",
    "module": "commonjs",
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "preserveConstEnums": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "lib": ["es5", "dom"],
    "types": ["webpack-env"],
    "isolatedModules": true
  },
  "include": ["src"]
}
