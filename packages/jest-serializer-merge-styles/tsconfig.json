{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "es2015",
    "outDir": "lib",
    "module": "commonjs",
    "lib": ["es2017", "dom"],
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "strict": true,
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "preserveConstEnums": true,
    "types": ["jest"],
    "isolatedModules": true
  },
  "include": ["src"]
}
