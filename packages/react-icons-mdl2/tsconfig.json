{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist",
    "target": "ES2019",
    "module": "commonjs",
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "noUnusedLocals": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "preserveConstEnums": true,
    "lib": ["ES2019", "DOM"],
    "types": ["jest", "node"],
    "isolatedModules": true
  },
  "include": ["src"]
}
