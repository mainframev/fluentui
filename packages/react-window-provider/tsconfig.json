{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist",
    "target": "es2015",
    "module": "commonjs",
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "noUnusedLocals": true,
    "strict": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "preserveConstEnums": true,
    "lib": ["es2015", "dom", "es2015.promise"],
    "typeRoots": ["../../node_modules/@types", "../../typings"],
    "types": ["jest", "custom-global"]
  },
  "include": ["src"]
}
