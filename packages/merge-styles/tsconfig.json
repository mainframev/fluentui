{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "es2015",
    "outDir": "lib",
    "module": "commonjs",
    "lib": ["ES5", "ES2015.Collection", "ES2015.Iterable", "ES2015.Symbol.WellKnown", "dom"],
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "strict": true,
    "moduleResolution": "bundler",
    "preserveConstEnums": true,
    "isolatedModules": true,
    "types": ["jest"]
  },
  "include": ["src"]
}
