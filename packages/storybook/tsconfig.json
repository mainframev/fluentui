{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "lib",
    "target": "es6",
    "module": "commonjs",
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "noUnusedLocals": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "preserveConstEnums": true,
    "lib": ["es6", "dom"],
    "types": [],
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
