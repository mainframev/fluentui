{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "es2015",
    "outDir": "lib",
    "module": "commonjs",
    "lib": ["es2017"],
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "noImplicitAny": true,
    "strict": false,
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
