{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "es2015",
    "module": "commonjs",
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "strict": false,
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    // `markdown-to-jsx` only publishes complete type declarations behind its `import` export condition;
    // its `require` declarations omit the `MarkdownToJSX` namespace. The docsite is bundled as ESM, so
    // resolve package types through the `import` condition.
    "customConditions": ["import"],
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "noImplicitThis": true,
    "outDir": "lib",
    "lib": ["es5", "dom", "es2015.promise", "ES2015.Symbol.WellKnown"],
    "types": ["webpack-env", "jest"],
    "isolatedModules": true
  },
  "include": ["src"]
}
